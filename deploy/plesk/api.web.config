<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces the web.config that `dotnet publish` writes into the API's publish folder.

  Everything the API needs is set here as an environment variable, because a
  panel-only deployment has no shell to export them from. Edit the values marked
  CHANGE ME, upload the folder to the API domain's httpdocs, and recycle the
  application pool from Plesk.

  Keep this file out of source control once it holds real secrets.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath=".\eAccountingServer.WebApi.exe"
                  arguments=""
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- IIS terminates TLS in front of the app, so the app must not redirect again. -->
          <environmentVariable name="UseHttpsRedirection" value="false" />

          <!-- CHANGE ME: the Plesk MSSQL database, user and password. -->
          <environmentVariable name="ConnectionStrings__SqlServer"
                               value="Server=localhost;Database=eAccountingServerDb;User Id=DB_USER;Password=DB_PASSWORD;TrustServerCertificate=True;Encrypt=True" />

          <!-- CHANGE ME: a long random string. Generate one and never reuse it elsewhere. -->
          <environmentVariable name="Jwt__SecretKey" value="CHANGE_ME" />
          <environmentVariable name="Jwt__Issuer" value="eAccounting" />
          <environmentVariable name="Jwt__Audience" value="eAccounting" />

          <!-- CHANGE ME: the client's address, so the browser is allowed to call this API. -->
          <environmentVariable name="Cors__AllowedOrigins__0" value="https://example.com" />

          <!-- Applies pending migrations to the main database on startup. -->
          <environmentVariable name="Database__MigrateOnStartup" value="true" />

          <!-- No mail server is wired up, so confirmation cannot be required. -->
          <environmentVariable name="Identity__RequireConfirmedEmail" value="false" />

          <!-- CHANGE ME: password for the seeded admin account. -->
          <environmentVariable name="Seed__AdminPassword" value="CHANGE_ME" />

          <environmentVariable name="Demo__Enabled" value="true" />

          <!--
            One sandbox database per slot, and they must already exist: a Plesk database
            user owns its own databases but cannot create new ones. Create
            eAccounting_Demo_Slot01..03 in Plesk and grant this user access to each.
          -->
          <environmentVariable name="Demo__SlotCount" value="3" />
          <environmentVariable name="Demo__DatabaseNamePrefix" value="eAccounting_Demo_Slot" />

          <environmentVariable name="Demo__WriteLimit" value="40" />
          <environmentVariable name="Demo__NudgeAfterWrites" value="15" />
          <environmentVariable name="Demo__IdleTimeoutMinutes" value="10" />
          <environmentVariable name="Demo__AbsoluteTimeoutMinutes" value="30" />

          <!-- Shared hosting is memory constrained; sessions are released above this. -->
          <environmentVariable name="Demo__MemoryThresholdMegabytes" value="400" />

          <environmentVariable name="Demo__ContactUrl" value="https://ataberkkaya.com" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
