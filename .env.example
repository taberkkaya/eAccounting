# Copy to .env and fill in before running docker compose up.

# SQL Server sa password: at least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# JWT signing key. Generate one, for example:
#   openssl rand -hex 64
JWT_SECRET=

# Password for the seeded admin account.
ADMIN_PASSWORD=

# Where the demo prompt sends visitors who want to get in touch.
CONTACT_URL=https://ataberkkaya.com

# Production: the domain the site answers on, e.g. demo.example.com. Caddy then
# provisions and renews a Let's Encrypt certificate for it automatically.
# Local: leave as :80 for plain HTTP.
SITE_ADDRESS=:80

# Host ports Caddy is published on. Use 80 and 443 on a server so the certificate
# challenge can reach it.
HTTP_PORT=8080
HTTPS_PORT=8443
