# Copy to .env and fill in before running docker compose up.

# --- Database ---------------------------------------------------------------
# The SQL Server the app uses. Point it at whatever server you already have;
# for a host-managed instance on a non-default port use "IP,PORT".
#   Server=203.0.113.10,51845;Database=my_main_db;User Id=my_user;Password=...;TrustServerCertificate=True;Encrypt=True
SQL_CONNECTION_STRING=

# Sandbox databases for the demo. The app appends 01, 02, ... to this prefix, so a
# prefix of "acme_demoslot" with 3 slots expects acme_demoslot01..03 to exist.
# They must be created ahead of time when the database user cannot create databases,
# and the same user needs access to all of them.
DEMO_DB_PREFIX=eAccounting_Demo_Slot
DEMO_SLOT_COUNT=3

# Only used with docker-compose.sqlserver.yml, which runs a SQL Server in the stack.
# At least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# --- Application ------------------------------------------------------------
# JWT signing key. Generate one, for example:
#   openssl rand -hex 64
JWT_SECRET=

# Password for the seeded admin account.
ADMIN_PASSWORD=

# Where the demo prompt sends visitors who want to get in touch.
CONTACT_URL=https://ataberkkaya.com

# --- Mail ------------------------------------------------------------------
# Leave MAIL_SMTP_HOST empty and the app drops outgoing mail silently, which is
# fine for a demo. To send for real, all of these matter:
#
# MAIL_FROM must be an address on a domain you own, or receiving servers will
# reject it - SPF and DKIM cannot be set up for a domain that is not yours.
MAIL_FROM=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# The public address of this deployment. Confirmation links are built on it, so
# an empty or wrong value sends recipients somewhere they cannot reach.
PUBLIC_URL=

# Working set above which the demo releases its least recently used sessions.
DEMO_MEMORY_MB=768

# --- Web --------------------------------------------------------------------
# Production: the domain the site answers on, e.g. demo.example.com. Caddy then
# provisions and renews a Let's Encrypt certificate for it automatically.
# Local: leave as :80 for plain HTTP.
SITE_ADDRESS=:80

# Host ports Caddy is published on. Use 80 and 443 on a server so the certificate
# challenge can reach it.
HTTP_PORT=8080
HTTPS_PORT=8443
